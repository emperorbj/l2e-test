TN_API_BASE_URL=<TN dev backend URL>
L2E_API_KEY=<dev key, from the TN backend team>
TICKET_SECRET=<random, 32+ characters>
STANDIN_PASSWORD=<shared test password>
ALLOWED_EMAIL_DOMAIN=l2e-test.dev
# Optional: where Apply links point. Defaults to the TN dev frontend.
TN_FRONTEND_URL=https://talent-nation-build-fe-dev-14573850302.europe-west1.run.app
# Added by Vercel when you connect Upstash Redis (KV_REST_API_* also works).
# Without them, local dev falls back to an in-memory used-ticket store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
